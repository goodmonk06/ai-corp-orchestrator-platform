# Root .env.example
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_corp_orchestrator?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# External Services (Optional)
VECTOR_KNOWLEDGE_API_URL=http://localhost:8001
VECTOR_KNOWLEDGE_API_KEY=
AUTOMATION_RECIPES_API_URL=http://localhost:8002
AUTOMATION_RECIPES_API_KEY=

# API Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Web App
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_ORG_ID=
NEXT_PUBLIC_DEFAULT_USER_ID=

# Worker
WORKER_CONCURRENCY=5

# Logging
LOG_LEVEL=info
